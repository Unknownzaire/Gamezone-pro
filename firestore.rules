/**
 * This ruleset enforces a security model for the Gamezone Pro application with a
 * clear separation between private user data and public/managed data.
 *
 * Core Philosophy:
 * The security model is primarily based on user ownership and administrative roles.
 * User-specific data (profiles, transactions, participation history) is strictly
 * private and can only be accessed by the owning user. Global data like tournaments
 * is publicly readable but managed exclusively by administrators.
 *
 * Data Structure:
 * - /users/{userId}: Contains private user profile data. All sensitive, user-specific
 *   subcollections (transactions, participants) are nested under this path.
 * - /roles_admin/{userId}: An access-control collection where the existence of a
 *   document signifies that the user is an administrator.
 * - /tournaments/{tournamentId}: A top-level collection for all tournament data,
 *   intended for public read access.
 *
 * Key Security Decisions:
 * - Strict User Data Isolation: All paths under /users/{userId} are governed by an
 *   ownership check, preventing any user from accessing another user's data.
 * - Admin-Managed Content: Tournaments are managed by users with an admin role,
 *   defined by the existence of a document in the /roles_admin collection. This avoids
 *   hardcoding UIDs and provides a flexible role system. Client-side modifications to
 *   the roles collection are disallowed to prevent privilege escalation.
 * - Public Listing is Deliberate: Only the /tournaments collection allows public
 *   listing. Listing all users via /users is explicitly forbidden.
 * - Authorization over Validation: In this prototyping stage, rules focus on *who*
 *   can perform an action, not the exact *shape* of the data. Validation is limited to
 *   fields critical for maintaining relational integrity and ownership (e.g., user IDs).
 *
 * Denormalization for Authorization:
 * - Admin roles are stored in `/roles_admin/{userId}`. This allows a fast `exists()`
 *   check to determine if a user is an admin without reading a user document, making
 *   rules on other collections (like /tournaments) efficient and secure.
 * - User participation records are stored under the user's own data tree
 *   (`/users/{userId}/participants/{participantId}`). This scopes the data directly
 *   to the owner, simplifying access control and avoiding complex queries or lookups
 *   in the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     * @param userId The user ID to check against the request's auth UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Checks if the document being accessed already exists in Firestore.
     * Crucial for protecting against writes on non-existent documents.
     */
    function isExistingDoc() {
        return resource != null;
    }

    /**
     * Checks if the authenticated user is the owner of an EXISTING document.
     * Used for safe update and delete operations.
     * @param userId The user ID to check against the request's auth UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    /**
     * Checks if the user has administrative privileges.
     * Admin status is determined by the existence of a document for the user
     * in the /roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow A user (auth.uid='user123') can (create) their own user document at /users/user123.
     * @deny An anonymous user cannot (get) any user document.
     * @deny A logged-in user (auth.uid='user456') cannot (update) another user's document at /users/user123.
     * @principle Restricts access to a user's own data tree (Ownership).
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's participation record in tournaments.
       * @path /users/{userId}/participants/{participantId}
       * @allow A user (auth.uid='user123') can (list) their own participation records at /users/user123/participants.
       * @deny A user (auth.uid='user456') cannot (get) a record at /users/user123/participants/p1.
       * @principle Inherits ownership from the parent document path.
       */
      match /participants/{participantId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's financial transaction history.
       * @path /users/{userId}/transactions/{transactionId}
       * @allow A user (auth.uid='user123') can (create) a new transaction at /users/user123/transactions/t1.
       * @deny A user (auth.uid='user456') cannot (list) transactions at /users/user123/transactions.
       * @principle Inherits ownership from the parent document path.
       */
      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Defines which users are administrators.
     * @path /roles_admin/{userId}
     * @allow An admin user can (get) a document at /roles_admin/anotherAdminId to check their status.
     * @deny A non-admin user cannot (list) the collection.
     * @deny No user can (create), (update), or (delete) roles from the client to prevent privilege escalation.
     * @principle Role-based access control; client-side modifications are locked down.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages public tournament information.
     * @path /tournaments/{tournamentId}
     * @allow Any user, including anonymous ones, can (get) or (list) tournaments.
     * @deny A non-admin user cannot (create) a new tournament.
     * @deny A logged-in user who is not an admin cannot (update) a tournament.
     * @principle Public read access with writes restricted to administrators.
     */
    match /tournaments/{tournamentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && request.resource.data.id == tournamentId;
      allow update: if isAdmin() && isExistingDoc();
      allow delete: if isAdmin() && isExistingDoc();
    }
  }
}